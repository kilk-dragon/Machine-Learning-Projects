import pandas as pd
from lightfm import LightFM
from lightfm.evaluation import precision_at_k

# Load movie ratings dataset
# Assume `ratings.csv` has columns: user_id, movie_id, rating
ratings = pd.read_csv("ratings.csv")

# Convert ratings into an interaction matrix
from scipy.sparse import coo_matrix

interaction_matrix = coo_matrix(
    (ratings['rating'], (ratings['user_id'], ratings['movie_id']))
)

# Build the model using Weighted Approximate-Rank Pairwise (WARP) loss
model = LightFM(loss='warp', no_components=50, random_state=42)
model.fit(interaction_matrix, epochs=10, num_threads=4)

